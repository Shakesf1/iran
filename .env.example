# Copy to .env and fill in real values. Never commit the real .env.

RESEND_API_KEY=

# Self-hosted Postgres (see selfhost/). Cron jobs run on the same box as
# the database, so this stays on localhost rather than the public
# api.warescalation.com domain.
POSTGREST_URL=http://127.0.0.1:3000
# From selfhost/gen_jwt.py — the service_role token, bypasses RLS.
SERVICE_ROLE_KEY=
